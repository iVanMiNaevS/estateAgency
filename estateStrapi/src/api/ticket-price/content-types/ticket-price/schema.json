{
  "kind": "collectionType",
  "collectionName": "ticket_prices",
  "info": {
    "singularName": "ticket-price",
    "pluralName": "ticket-prices",
    "displayName": "ticketPrice",
    "description": "Тариф на билет: взрослый, детский, семейный, групповой"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "ticket",
        "service",
        "benefit"
      ],
      "default": "ticket",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "oldPrice": {
      "type": "integer",
      "min": 0,
      "description": "Цена до скидки, для показа перечёркнутой"
    },
    "adultPercent": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 100,
      "description": "Доля цены сеанса, которую платит взрослый, в процентах. 100 — полная цена"
    },
    "childPercent": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "default": 100,
      "description": "Доля цены сеанса, которую платит ребёнок, в процентах"
    },
    "minGuests": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "description": "Минимум гостей в заявке. 0 — тариф доступен всегда"
    },
    "minAdults": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "description": "Минимум взрослых. 0 — ограничения нет"
    },
    "minChildren": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "description": "Минимум детей. 0 — ограничения нет"
    },
    "durationMinutes": {
      "type": "integer",
      "min": 0,
      "description": "Длительность действия тарифа в минутах, если применимо"
    },
    "cancelPolicy": {
      "type": "text",
      "description": "Условия отмены по этому тарифу"
    },
    "includes": {
      "type": "component",
      "component": "ticket-price.price-include",
      "repeatable": true
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "bookings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking.booking",
      "mappedBy": "tariff"
    }
  }
}