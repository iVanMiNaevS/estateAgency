{
  "kind": "collectionType",
  "collectionName": "user_requests",
  "info": {
    "singularName": "user-request",
    "pluralName": "user-requests",
    "displayName": "userRequest"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "secondName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string",
      "description": "Телефон гостя, в т.ч. с кодом города или в формате +7"
    },
    "message": {
      "type": "text"
    },
    "activeContact": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "in_progress", "done", "rejected"],
      "default": "new"
    },
    "adminComment": {
      "type": "text",
      "description": "Комментарий администратора по заявке"
    }
  }
}
