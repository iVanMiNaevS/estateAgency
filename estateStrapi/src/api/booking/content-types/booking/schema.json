{
  "kind": "collectionType",
  "collectionName": "bookings",
  "info": {
    "singularName": "booking",
    "pluralName": "bookings",
    "displayName": "booking",
    "description": "Бронирование посещения парка развлечений"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "bookings",
      "required": true
    },
    "session": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::session.session",
      "inversedBy": "bookings",
      "required": true
    },
    "tariff": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ticket-price.ticket-price",
      "inversedBy": "bookings",
      "description": "Выбранный тариф. Взрослых и детей считаем по нему, если он задан"
    },
    "adultsCount": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 1,
      "description": "Количество взрослых"
    },
    "childrenCount": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0,
      "description": "Количество детей"
    },
    "guestsCount": {
      "type": "integer",
      "required": true,
      "min": 1,
      "default": 1,
      "description": "Всего гостей = взрослые + дети. Заполняется автоматически"
    },
    "totalPrice": {
      "type": "integer",
      "required": true,
      "min": 0,
      "default": 0,
      "description": "Сумма, рассчитанная сервером по тарифу. Значение по умолчанию нужно только для прохождения валидации до lifecycle, реальную цену ставит beforeCreate"
    },
    "bookingStatus": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "paid", "completed", "cancelled", "rejected"],
      "default": "pending",
      "required": true,
      "description": "Новая, подтверждена, оплачена, завершена, отменена, отказ. Имя не status: это служебное поле Strapi (черновик/публикация), и поле с таким именем нельзя сохранить из админки"
    },
    "contactName": {
      "type": "string",
      "description": "Имя гостя для связи"
    },
    "contactPhone": {
      "type": "string",
      "description": "Телефон гостя для связи"
    },
    "wishes": {
      "type": "text",
      "description": "Особые пожелания клиента к посещению"
    },
    "comment": {
      "type": "text",
      "description": "Комментарий администратора: причина отказа и т.п."
    },
    "cancelledAt": {
      "type": "datetime",
      "description": "Когда бронь была отменена"
    },
    "prepaidAmount": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "description": "Внесённая гостем предоплата в рублях. 0 — предоплаты нет. Остаток суммы сдаётся в кассе на месте"
    },
    "prepaidAt": {
      "type": "datetime",
      "description": "Когда внесена предоплата"
    }
  }
}